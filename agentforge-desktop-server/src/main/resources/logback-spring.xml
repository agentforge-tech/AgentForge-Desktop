<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      日志根目录跟随桌面端数据根目录：
      - 安装版默认：~/.agentforge-desktop/logs
      - 本地开发默认：agentforge-desktop-ui/.agentforge-dev/logs
      - 自定义：agentforge.desktop.root-dir 命令行属性或 AGENTFORGE_DESKTOP_ROOT_DIR
    -->
    <springProperty scope="context"
                    name="DESKTOP_ROOT"
                    source="agentforge.desktop.root-dir"
                    defaultValue="${user.home}/.agentforge-desktop"/>
    <property name="LOG_HOME" value="${DESKTOP_ROOT}/logs"/>
    <property name="LOG_FILE" value="${LOG_HOME}/agentforge-desktop.log"/>
    <property name="LOG_ARCHIVE" value="${LOG_HOME}/archive"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{48} [%file:%line] - %msg%n"/>

    <!-- 保留控制台日志，Electron 会继续以 [desktop-server] 前缀转发到主进程输出。 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!--
      当前日志写入 agentforge-desktop.log；同时按日期和单文件大小滚动压缩归档。
      每个归档文件最大 20 MB，最多保留 30 天，总归档容量上限 1 GB。
    -->
    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <append>true</append>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/agentforge-desktop.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ROLLING_FILE"/>
    </root>
</configuration>
